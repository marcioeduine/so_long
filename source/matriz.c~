#include "../include/so_long.h"

int	matriz(t_dados *ptr)
{
	int	i;
	int	j;

	ptr->matriz = ft_split(ptr->str, '\n');
	if (!ptr->matriz)
		return (0);
	i = -1;
	j = -1;
	while (ptr->matriz[0][++i])
		if (ptr->matriz[0][i] != '1')
			return (0);
	while (ptr->matriz[++j])
		if (ptr->matriz[j][0] != '1')
			return (0);
	i = -1;
	while (ptr->matriz[j - 1][++i])
		if (ptr->matriz[j - 1][i] != '1')
			return (0);
	i--;
	while (--j)
		if (ptr->matriz[j - 1][i] != '1')
			return (0);
	return (1);
}

#include "../include/so_long.h"

void	ss_searching_valid_path_in_the_map(t_game *game_data, char c)
{
	int		i;
	int		j;
	t_bool	valid_path;
	char	**temp_map;

	i = -1;
	while (++i < c_m_lin(game_data->map))
	{
		j = -1;
		while (++j < c_m_col(game_data->map))
		{
			if (game_data->map[i][j] == c)
			{
				temp_map = copy_matrix(game_data->map,
						c_m_lin(game_data->map), 0);
				if (!temp_map)
					return ;
				valid_path = FALSE;
				flood_fill(temp_map, i, j, &valid_path);
				free_matrix(temp_map, c_m_lin(game_data->map));
				if (!valid_path)
					fechar_mapa("There is not a valid path in the map!\n");
			}
		}
	}
}
